{
	"manifest_version": 3,
	"name": "Booru Slideshow",
	"short_name": "Booru SS",
	"description": "View a slideshow from a Booru site based on your search.",
	"version": "10.9",
	"action": {
		"default_icon": "img/bs_icon_19.png",
		"default_popup": "popup.html"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "{1bb0deba-416a-4848-b119-9b94f37a268d}",
			"strict_min_version": "113.0"
		}
	},
	"incognito": "spanning",
	"icons": {
		"16": "img/bs_icon_16.png",
		"48": "img/bs_icon_48.png",
		"128": "img/bs_icon_128.png"
	},
	"permissions": [
		"unlimitedStorage",
		"storage",
		"declarativeNetRequestWithHostAccess",
		"downloads",
		"scripting"
	],
	"host_permissions": [
		"https://booru.allthefallen.moe/*",
		"https://*.gelbooru.com/*",
		"https://api.rule34.xxx/*",
		"https://rule34hentai.net/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://rule34hentai.net/*"
			],
			"js": [
				"js/content/rule34hentai_relay.js"
			],
			"run_at": "document_idle"
		}
	],
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "ruleset_header_referer",
				"enabled": true,
				"path": "rules_header_referer.json"
			}
		]
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; img-src 'self' https: blob:; media-src 'self' https: blob:; connect-src 'self' https://booru.allthefallen.moe https://gelbooru.com https://*.gelbooru.com https://api.rule34.xxx https://rule34hentai.net"
	}
}